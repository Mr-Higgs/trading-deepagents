# OANDA v20 — PRACTICE ONLY. This system refuses to touch a live account (see trading_agent/oanda_env.py):
# it runs only when OANDA_ENV=practice AND the resolved account id starts with 101- (practice; 001- = live).
#
# OANDA_API_KEY MUST be a *practice* token — generate it from the fxTrade Practice (demo) portal, NOT the
# live site. A live token 401s ("Insufficient authorization") against the practice endpoint.
OANDA_API_KEY=your-PRACTICE-personal-access-token
# Practice (demo) account, 101-... — preferred and used in practice mode.
OANDA_DEMO_ACCOUNT_ID=101-xxx-xxxxxxxx-xxx
# Optional live account (001-...). Ignored by the guard; kept only so you don't have to delete it.
OANDA_ACCOUNT_ID=001-xxx-xxxxxxxx-xxx
OANDA_ENV=practice
# PRACTICE_URL/LIVE_URL are unused — the client derives the host from OANDA_ENV.
PRACTICE_URL=https://api-fxpractice.oanda.com
LIVE_URL=https://api-fxtrade.oanda.com

# Phase 2 only (deepagents confirmation gate). Needed for `live --strategy agent`.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Phase 2 UI demo only: `langgraph dev` (serves trading_agent/graph.py to the Deep Agents UI) uses this.
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key

TAVILY_API_KEY=tvly-dev-XXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Concurrent jobs per dev worker; keeps the dashboard responsive during long research runs.
N_JOBS_PER_WORKER=10
